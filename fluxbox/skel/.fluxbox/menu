[begin] (FluxBox)
    [submenu] (Development)
        [exec] (Fluid) {fluid}
        [exec] (Python) {xterm -e python}
    [end]
    [submenu] (Editors)
        [exec] (Mousepad) {mousepad}
        [exec] (Nano) {xterm -e nano}
        [exec] (Vi) {xterm -e vi}
        [exec] (Vim) {xterm -e vim}
    [end]
    [submenu] (Games)
        [submenu] (Amusement)
            [exec] (Xclock [digital]) {xclock -digital -update 1}
            [exec] (Xeyes) {xeyes}
        [end]
    [end]
    [submenu] (Graphics)
        [exec] (Xpdf) {xpdf}
    [end]
    [submenu] (Multimedia)
        [exec] (ALSA mixer) {xterm -e alsamixer}
        [exec] (cam) {xterm -font vga -geometry 80x25 -bg black -fg gray -e /usr/bin/cam}
        [exec] (cam) {xterm -e cam}
        [exec] (Echomixer) {echomixer}
        [exec] (Envy24 Control) {envy24control}
        [exec] (HDAJackRetask) {hdajackretask}
        [exec] (HDSPConf) {hdspconf}
        [exec] (HDSPMixer) {hdspmixer}
        [exec] (Hwmixvolume) {hwmixvolume}
        [exec] (mpv Media Player) {mpv --player-operation-mode=pseudo-gui}
        [exec] (Rmedigicontrol) {rmedigicontrol}
    [end]
    [submenu] (Network)
        [exec] (FireFox) {firefox}
        [exec] (Geary) {geary}
        [exec] (TkVNC) {xterm -e tkvnc}
        [exec] (Transmission [Qt]) {transmission-qt}
        [exec] (uGet) {env GDK_BACKEND=x11 uget-gtk}
    [end]
    [submenu] (Office)
        [exec] (Zathura) {zathura}
    [end]
    [submenu] (Science)
        [exec] (bc) {xterm -e bc}
        [exec] (dc) {xterm -e dc}
        [exec] (Xcalc) {xcalc}
    [end]
    [submenu] (Shells)
        [exec] (Dash) {xterm -e dash -i}
        [exec] (GIT) {xterm -e git}
        [exec] (d77run) {d77run}
        [exec] (PCMan File Manager) {pcmanfm}
        [exec] (ranger) {xterm -e ranger}
        [exec] (ST) {st}
        [exec] (UXTerm) {uxterm}
        [exec] (Xterm) {xterm}
    [end]
    [submenu] (System)
        [submenu] (Settings)
            [submenu] (GNOME)
                [exec] (Advanced Network Configuration) {nm-connection-editor}
            [end]
            [exec] (Desktop Preferences) {pcmanfm --desktop-pref}
            [exec] (GTK Settings) {nwg-look}
            [exec] (Kvantum Manager) {kvantummanager}
            [exec] (Manage Printing) {xdg-open http://localhost:631/}
            [exec] (Preferred Applications) {libfm-pref-apps}
            [exec] (Print Settings) {system-config-printer}
            [exec] (Qt5 Settings) {qt5ct}
            [exec] (Qt6 Settings) {qt6ct}
        [end]
        [exec] (chronyc) {xterm -e chronyc}
        [exec] (conky) {conky --daemonize --pause=1}
        [exec] (Conky) {xterm -e conky}
        [exec] (d77-welcome) {xterm -e d77-welcome}
        [exec] (Htop) {xterm -e htop}
        [exec] (Install System) {sudo -E calamares}
        [exec] (jgmenu) {jgmenu_run}
        [exec] (OctoXBPS) {octoxbps}
        [exec] (OctoXBPS Notifier) {octoxbps-notifier}
        [exec] (Top) {xterm -e top}
        [exec] (Xconsole) {xconsole}
        [exec] (XLoad) {xload}
    [end]
    [submenu] (Utilities)
        [exec] (About Xfce) {xfce4-about}
        [exec] (Oclock) {oclock}
        [exec] (Redshift) {redshift-gtk}
        [exec] (Xarchiver) {xarchiver}
        [exec] (Xclipboard) {xclipboard}
        [exec] (Xclock [analog]) {xclock -analog}
        [exec] (Xclock [digital]) {xclock -digital}
        [exec] (Xcutsel) {xcutsel}
        [exec] (Xev) {xterm -e xev}
        [exec] (XFontSel) {xfontsel}
        [exec] (Xkill) {xkill}
        [exec] (Xlogo) {xlogo}
        [exec] (Xrefresh) {xrefresh}
        [exec] (Xsetroot) {xsetroot}
    [end]
    [separator]
    [submenu] (FluxBox)
        [workspaces] (Workspaces)
        [submenu] (Styles)
            [stylesdir] (/usr/share/fluxbox/styles)
            [stylesdir] (~/.fluxbox/styles)
        [end]
        [config] (Configure)
        [reconfig] (Reconfig)
        [restart] (Restart)
        [separator]
        [exit] (Exit)
    [end]
[end]
