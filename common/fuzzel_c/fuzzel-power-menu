#!/usr/bin/env bash

SELECTION=$(echo -e "󰒲 Suspend\n Logout\n Reboot\n Shutdown" | fuzzel -d -p " " -w 15 -l 4)

reboot_confirm() {
	CONFIRM=$(echo -e "confirm reboot\ncancel reboot" | fuzzel -d -p " " -w 15 -l 2)
	case $CONFIRM in
		"confirm reboot")
			loginctl reboot
			;;
		*)
			;;
	esac
}
shutdown_confirm() {
	CONFIRM=$(echo -e "confirm shutdown\ncancel shutdown" | fuzzel -d -p " " -w 15 -l 2)
	case $CONFIRM in
		"confirm shutdown")
			loginctl poweroff
			;;
		*)
			;;
	esac
}

case $SELECTION in
	"󰒲 Suspend")
		loginctl suspend
		;;
	" Logout")
		# WM-agnostic: end this login session via elogind (SIGTERM -> SIGKILL),
		# whatever the compositor. Falls back to the whole user if the session
		# id isn't in the env.
		loginctl terminate-session "${XDG_SESSION_ID:-}" 2>/dev/null || loginctl terminate-user "$USER"
		;;
	" Reboot")
		reboot_confirm
		;;
	" Shutdown")
		shutdown_confirm
		;;
	*)
		;;
esac
