def find_libdir():
    installed = "/usr/lib/lib-d77-welcome"
    if os.path.isdir(installed):
        return installed
    local = os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib-d77-welcome")
    if os.path.isdir(local):
        return local
    return installed


