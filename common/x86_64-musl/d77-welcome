def create_flag():
    os.makedirs(CONFIG_DIR, exist_ok=True)
    if not os.path.exists(FLAG_FILE):
        open(FLAG_FILE, "a").close()


def user_in_wheel():
    try:
        wheel_gid = grp.getgrnam("wheel").gr_gid
    except KeyError:
        return False
    return wheel_gid in os.getgroups()


def read_home_readme():
    """Reads ~/README.md, if present, for display on the welcome screen."""
    path = os.path.join(GLib.get_home_dir(), "README.md")
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return fh.read()
    except OSError:
        return None


_MD_HEADING_RE = re.compile(r"^(#{1,6})\s+(.*)")
_MD_LIST_RE = re.compile(r"^[-*]\s+(.*)")
_MD_BOLD_RE = re.compile(r"\*\*(.+?)\*\*")
_MD_ITALIC_RE = re.compile(r"(?<!\*)\*(?!\*)(.+?)(?<!\*)\*(?!\*)")
_MD_CODE_RE = re.compile(r"`([^`]+?)`")
_MD_HEADING_SIZES = {1: "xx-large", 2: "x-large", 3: "large"}


def markdown_to_pango(text):
    """Very small Markdown subset (headings, lists, bold/italic/code) -> Pango markup."""
    escaped = GLib.markup_escape_text(text)
    out_lines = []
    for line in escaped.split("\n"):
        stripped = line.lstrip()
        heading = _MD_HEADING_RE.match(stripped)
        if heading:
            level = len(heading.group(1))
            size = _MD_HEADING_SIZES.get(level, "medium")
            out_lines.append(f'<span size="{size}" weight="bold">{heading.group(2)}</span>')
            continue
        item = _MD_LIST_RE.match(stripped)
        if item:
            out_lines.append("    • " + item.group(1))
            continue
        out_lines.append(line)
    body = "\n".join(out_lines)
    body = _MD_BOLD_RE.sub(r"<b>\1</b>", body)
    body = _MD_ITALIC_RE.sub(r"<i>\1</i>", body)
    body = _MD_CODE_RE.sub(r"<tt>\1</tt>", body)
    return body


def load_css():
    css = b"""
    label.monospace { font-family: monospace; }
    label.error-text { color: #e01b24; }
    """
    provider = Gtk.CssProvider()
    provider.load_from_data(css)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(),
        provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
    )


class PrivilegedRunner:
    """Runs lib-d77-welcome scripts, feeding sudo -A a cached password."""

    def __init__(self):
        self._password = None
        self._tempdir = tempfile.mkdtemp(prefix="d77-welcome-")
        self._askpass = os.path.join(self._tempdir, "askpass.sh")
        with open(self._askpass, "w") as fh:
            fh.write("#!/bin/sh\nprintf '%s\\n' \"$D77_SUDO_PASS\"\n")
        os.chmod(self._askpass, stat.S_IRWXU)

    def _env(self, password):
        env = os.environ.copy()
        env["SUDO_ASKPASS"] = self._askpass
        env["D77_SUDO_PASS"] = password
        return env

    def _check_password(self, password):
        subprocess.run(["sudo", "-k"], check=False)
        result = subprocess.run(
            ["sudo", "-A", "-v"],
            env=self._env(password),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return result.returncode == 0

    def ensure_password(self, parent):
        if self._password is not None:
            return True

        dialog = Gtk.Dialog(title="Administrator Password", transient_for=parent, modal=True)
        dialog.add_buttons(
            "_Cancel", Gtk.ResponseType.CANCEL,
            "_Authenticate", Gtk.ResponseType.OK,
        )
        dialog.set_default_response(Gtk.ResponseType.OK)

        box = dialog.get_content_area()
        box.set_spacing(8)
        box.set_border_width(16)

        label = Gtk.Label(label="This action requires administrator privileges.\nEnter your password:")
        label.set_xalign(0)
        box.add(label)

        entry = Gtk.Entry()
        entry.set_visibility(False)
        entry.set_activates_default(True)
        box.add(entry)

        error_label = Gtk.Label()
        error_label.set_xalign(0)
        error_label.get_style_context().add_class("error-text")
        box.add(error_label)

        box.show_all()
        error_label.hide()
        entry.grab_focus()

        while True:
            response = dialog.run()
            if response != Gtk.ResponseType.OK:
                dialog.destroy()
                return False

            password = entry.get_text()
            entry.set_sensitive(False)
            while Gtk.events_pending():
                Gtk.main_iteration()

            if self._check_password(password):
                self._password = password
                dialog.destroy()
                return True

            entry.set_sensitive(True)
            entry.set_text("")
            entry.grab_focus()
            error_label.set_text("Incorrect password, please try again.")
            error_label.show()

    def run_script(self, step, parent, on_output, on_done, stdin_data=None):
        if step.get("requires_root") and not self.ensure_password(parent):
            on_done(None)
            return

        script_path = os.path.join(LIBDIR, step["script"])
        env = self._env(self._password or "")

        def worker():
            try:
                proc = subprocess.Popen(
                    ["bash", script_path],
                    stdin=subprocess.PIPE if stdin_data else subprocess.DEVNULL,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    env=env,
                    text=True,
                    bufsize=1,
                )
            except OSError as exc:
                GLib.idle_add(on_output, f"Failed to start: {exc}\n")
                GLib.idle_add(on_done, 1)
                return

            if stdin_data:
                proc.stdin.write(stdin_data)
                proc.stdin.close()

            for line in proc.stdout:
                GLib.idle_add(on_output, line)
            proc.wait()
            GLib.idle_add(on_done, proc.returncode)

        threading.Thread(target=worker, daemon=True).start()


class MainWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=APP_TITLE)
        self.set_default_size(940, 620)
        self.runner = PrivilegedRunner()

        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.set_title(APP_TITLE)
        header.set_subtitle("Post-installation setup for d77void")
        finish_btn = Gtk.Button(label="Finish")
        finish_btn.get_style_context().add_class("suggested-action")
        finish_btn.connect("clicked", self.on_finish_clicked)
        header.pack_end(finish_btn)
        self.set_titlebar(header)

        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        self.add(paned)

        sidebar_scroller = Gtk.ScrolledWindow()
        sidebar_scroller.set_size_request(250, -1)
        sidebar_scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.sidebar = Gtk.ListBox()
        self.sidebar.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.sidebar.get_style_context().add_class("sidebar")
        for step in STEPS:
            self.sidebar.add(self._build_sidebar_row(step))
        self.sidebar.connect("row-selected", self.on_row_selected)
        sidebar_scroller.add(self.sidebar)
        paned.pack1(sidebar_scroller, resize=False, shrink=False)

        content_scroller = Gtk.ScrolledWindow()
        content_scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.content.set_border_width(24)
        content_scroller.add(self.content)
        paned.pack2(content_scroller, resize=True, shrink=False)
        paned.set_position(250)

        self._show_welcome()
        self.show_all()
        # GtkListBox in SINGLE selection mode auto-selects the first row once
        # mapped, which would silently replace the welcome screen. Undo it.
        self.sidebar.unselect_all()
        self._show_welcome()

    def _build_sidebar_row(self, step):
        row = Gtk.ListBoxRow()
        row.step = step
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        box.set_border_width(8)
        icon = Gtk.Image.new_from_icon_name(
            step.get("icon", "applications-system-symbolic"), Gtk.IconSize.MENU
        )
        box.pack_start(icon, False, False, 0)
        label = Gtk.Label(label=step["title"])
        label.set_xalign(0)
        box.pack_start(label, True, True, 0)
        if step["kind"] == "category":
            arrow = Gtk.Image.new_from_icon_name("go-next-symbolic", Gtk.IconSize.MENU)
            box.pack_start(arrow, False, False, 0)
        row.add(box)
        return row

    def _clear_content(self):
        for child in self.content.get_children():
            self.content.remove(child)

    def _panel_title(self, text, size="x-large"):
        title = Gtk.Label()
        title.set_markup(f"<span size='{size}' weight='bold'>{GLib.markup_escape_text(text)}</span>")
        title.set_xalign(0)
        return title

    def _show_welcome(self):
        self._clear_content()
        readme_text = read_home_readme()

        if readme_text is not None:
            body = Gtk.Label()
            body.set_markup(markdown_to_pango(readme_text))
            body.set_xalign(0)
            body.set_line_wrap(True)
            body.set_selectable(True)
            self.content.pack_start(body, False, False, 0)
        else:
            self.content.pack_start(self._panel_title(APP_TITLE, "xx-large"), False, False, 0)
            body = Gtk.Label(label=WELCOME_TEXT)
            body.set_xalign(0)
            body.set_line_wrap(True)
            body.set_margin_top(16)
            self.content.pack_start(body, False, False, 0)

        autostart_path = os.path.join(GLib.get_home_dir(), ".auto.sh")
        if os.path.exists(autostart_path):
            dont_show_btn = Gtk.Button(label="Don't show this again")
            dont_show_btn.set_margin_top(16)
            dont_show_btn.set_halign(Gtk.Align.START)
            dont_show_status = Gtk.Label()
            dont_show_status.set_xalign(0)
            dont_show_status.set_margin_top(4)

            def on_dont_show_clicked(button):
                try:
                    os.remove(autostart_path)
                except OSError:
                    pass
                button.set_sensitive(False)
                dont_show_status.set_text("Won't run automatically at login anymore.")

            dont_show_btn.connect("clicked", on_dont_show_clicked)
            self.content.pack_start(dont_show_btn, False, False, 0)
            self.content.pack_start(dont_show_status, False, False, 0)

        self.content.show_all()

    def on_row_selected(self, listbox, row):
        if row is None:
            return
        step = row.step
        if step["kind"] == "category":
            self._show_category(step)
        elif step["kind"] == "root_password":
            self._show_root_password(step)
        else:
            self._show_action(step, back_to=None)

    def _show_category(self, step):
        self._clear_content()
        self.content.pack_start(self._panel_title(step["title"]), False, False, 0)

        listbox = Gtk.ListBox()
        listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        listbox.set_margin_top(12)
        listbox.get_style_context().add_class("frame")
        for item in step["items"]:
            row = Gtk.ListBoxRow()
            row.set_activatable(True)
            row.item = item
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            box.set_border_width(10)
            label = Gtk.Label(label=item["title"])
            label.set_xalign(0)
            box.pack_start(label, True, True, 0)
            arrow = Gtk.Image.new_from_icon_name("go-next-symbolic", Gtk.IconSize.MENU)
            box.pack_start(arrow, False, False, 0)
            row.add(box)
            listbox.add(row)
        listbox.connect("row-activated", lambda lb, r: self._show_action(r.item, back_to=step))
        self.content.pack_start(listbox, False, False, 0)
        self.content.show_all()

    def _show_action(self, item, back_to):
        self._clear_content()

        if back_to is not None:
            back_btn = Gtk.Button()
            back_box = Gtk.Box(spacing=6)
            back_box.pack_start(Gtk.Image.new_from_icon_name("go-previous-symbolic", Gtk.IconSize.MENU), False, False, 0)
            back_box.pack_start(Gtk.Label(label=f"Back to {back_to['title']}"), False, False, 0)
            back_btn.add(back_box)
            back_btn.set_relief(Gtk.ReliefStyle.NONE)
            back_btn.set_halign(Gtk.Align.START)
            back_btn.connect("clicked", lambda b: self._show_category(back_to))
            self.content.pack_start(back_btn, False, False, 0)

        title = self._panel_title(item["title"])
        title.set_margin_top(8)
        self.content.pack_start(title, False, False, 0)

        summary = Gtk.Label(label=item.get("summary", ""))
        summary.set_xalign(0)
        summary.set_line_wrap(True)
        summary.set_margin_top(8)
        self.content.pack_start(summary, False, False, 0)

        if item.get("packages"):
            pkg_label = Gtk.Label()
            pkg_label.set_markup("<b>Packages:</b> " + GLib.markup_escape_text(", ".join(item["packages"])))
            pkg_label.set_xalign(0)
            pkg_label.set_line_wrap(True)
            pkg_label.set_margin_top(8)
            self.content.pack_start(pkg_label, False, False, 0)

        if item.get("command_preview"):
            frame = Gtk.Frame()
            frame.set_margin_top(8)
            cmd_label = Gtk.Label(label=item["command_preview"])
            cmd_label.set_xalign(0)
            cmd_label.set_line_wrap(True)
            cmd_label.set_margin_start(8)
            cmd_label.set_margin_end(8)
            cmd_label.set_margin_top(8)
            cmd_label.set_margin_bottom(8)
            cmd_label.get_style_context().add_class("monospace")
            frame.add(cmd_label)
            self.content.pack_start(frame, False, False, 0)

        action_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        action_box.set_margin_top(16)
        run_btn = Gtk.Button(label="Run")
        run_btn.get_style_context().add_class("suggested-action")
        spinner = Gtk.Spinner()
        status_icon = Gtk.Image()
        status_label = Gtk.Label()
        action_box.pack_start(run_btn, False, False, 0)
        action_box.pack_start(spinner, False, False, 0)
        action_box.pack_start(status_icon, False, False, 0)
        action_box.pack_start(status_label, False, False, 0)
        self.content.pack_start(action_box, False, False, 0)

        output_scroller = Gtk.ScrolledWindow()
        output_scroller.set_margin_top(12)
        output_scroller.set_min_content_height(220)
        output_view = Gtk.TextView()
        output_view.set_editable(False)
        output_view.set_monospace(True)
        output_view.set_cursor_visible(False)
        output_buffer = output_view.get_buffer()
        output_scroller.add(output_view)
        self.content.pack_start(output_scroller, True, True, 0)

        def append_output(text):
            output_buffer.insert(output_buffer.get_end_iter(), text)
            output_view.scroll_mark_onscreen(output_buffer.get_insert())
            return False

        def on_done(returncode):
            spinner.stop()
            spinner.hide()
            run_btn.set_sensitive(True)
            if returncode is None:
                status_label.set_text("Cancelled")
                status_icon.set_from_icon_name("dialog-warning-symbolic", Gtk.IconSize.MENU)
            elif returncode == 0:
                status_label.set_text("Done")
                status_icon.set_from_icon_name("emblem-ok-symbolic", Gtk.IconSize.MENU)
            else:
                status_label.set_text(f"Failed (exit code {returncode})")
                status_icon.set_from_icon_name("dialog-error-symbolic", Gtk.IconSize.MENU)
            status_icon.show()
            return False

        def on_run_clicked(button):
            run_btn.set_sensitive(False)
            status_icon.hide()
            status_label.set_text("")
            output_buffer.set_text("")
            output_scroller.show()
            spinner.show()
            spinner.start()
            self.runner.run_script(item, self, append_output, on_done)

        run_btn.connect("clicked", on_run_clicked)

        self.content.show_all()
        spinner.hide()
        status_icon.hide()
        output_scroller.hide()

    def _show_root_password(self, step):
        self._clear_content()
        self.content.pack_start(self._panel_title(step["title"]), False, False, 0)

        summary = Gtk.Label(label=step.get("summary", ""))
        summary.set_xalign(0)
        summary.set_line_wrap(True)
        summary.set_margin_top(8)
        self.content.pack_start(summary, False, False, 0)

        grid = Gtk.Grid()
        grid.set_row_spacing(8)
        grid.set_column_spacing(12)
        grid.set_margin_top(16)

        pw1_label = Gtk.Label(label="New root password:")
        pw1_label.set_xalign(0)
        pw1_entry = Gtk.Entry()
        pw1_entry.set_visibility(False)
        grid.attach(pw1_label, 0, 0, 1, 1)
        grid.attach(pw1_entry, 1, 0, 1, 1)

        pw2_label = Gtk.Label(label="Confirm password:")
        pw2_label.set_xalign(0)
        pw2_entry = Gtk.Entry()
        pw2_entry.set_visibility(False)
        pw2_entry.set_activates_default(True)
        grid.attach(pw2_label, 0, 1, 1, 1)
        grid.attach(pw2_entry, 1, 1, 1, 1)

        self.content.pack_start(grid, False, False, 0)

        status_label = Gtk.Label()
        status_label.set_xalign(0)
        status_label.set_margin_top(8)
        self.content.pack_start(status_label, False, False, 0)

        set_btn = Gtk.Button(label="Set Root Password")
        set_btn.get_style_context().add_class("suggested-action")
        set_btn.set_margin_top(16)
        set_btn.set_halign(Gtk.Align.START)
        self.content.pack_start(set_btn, False, False, 0)

        def on_done(returncode):
            set_btn.set_sensitive(True)
            if returncode is None:
                status_label.set_text("Cancelled.")
            elif returncode == 0:
                status_label.set_text("Root password updated.")
                pw1_entry.set_text("")
                pw2_entry.set_text("")
            else:
                status_label.set_text(f"Failed to set root password (exit code {returncode}).")
            return False

        def on_click(button):
            pw1 = pw1_entry.get_text()
            pw2 = pw2_entry.get_text()
            if not pw1:
                status_label.set_text("Password cannot be empty.")
                return
            if pw1 != pw2:
                status_label.set_text("Passwords do not match.")
                return
            set_btn.set_sensitive(False)
            status_label.set_text("Setting root password...")
            self.runner.run_script(
                step, self, lambda text: False, on_done, stdin_data=f"root:{pw1}\n"
            )

        set_btn.connect("clicked", on_click)
        self.content.show_all()

    def on_finish_clicked(self, button):
        create_flag()
        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK,
            text=FINISH_TEXT,
        )
        dialog.run()
        dialog.destroy()
        self.get_application().quit()


class Application(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.d77void.Welcome")

    def do_startup(self):
        Gtk.Application.do_startup(self)
        load_css()

    def do_activate(self):
        win = self.get_active_window()
        if not win:
            win = MainWindow(self)
        win.present()


def main():
    argv = sys.argv[1:]

    if "--firstrun" in argv:
        overlay_present = os.path.isdir("/lib/live/mount/overlay")
        already_run = os.path.exists(FLAG_FILE)
        if overlay_present or already_run or not user_in_wheel():
            sys.exit(1)
        create_flag()
    elif "--open" in argv:
        pass
    else:
        create_flag()
        if not user_in_wheel():
            print("Error: must be a member of the wheel group to run this script.", file=sys.stderr)
            sys.exit(1)

    app = Application()
    app.run([sys.argv[0]])


if __name__ == "__main__":
    main()
